# Environment variables for our-ai-demo V0
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control

# AI Provider Selection
# Options: nvidia, anthropic, mock
AI_PROVIDER=nvidia

# NVIDIA NIMs (production)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nemotron-3-8b-chat

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=

# Performance
# Timeouts in seconds
AI_REQUEST_TIMEOUT=30.0
# Maximum time to wait for first token (streaming)
AI_STREAM_TIMEOUT=10.0

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Simulation Configuration (for V0)
SIMULATION_SEED=12345  # For deterministic behavior
